# MCP Server Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3031

# Mealie instance (optional if same as default)
MEALIE_BASE_URL=https://mealie.example.com

# Mealie API auth: use a token from Mealie Admin → API Tokens, or OIDC access token
BEARER_TOKEN_OAUTH2PASSWORDBEARER=your_mealie_api_token_here
# Alternative name (same effect):
# OAUTH_TOKEN_OAUTH2PASSWORDBEARER=your_mealie_api_token_here

# Food enrichment cache (optional)
# ENRICHMENT_CACHE_ENABLED=true
# ENRICHMENT_CACHE_TTL_HOURS=24
# Bump after parser or cache-payload changes so old price rows are not reused:
# ENRICHMENT_CACHE_SCHEMA_VERSION=1

# Optional: convert leading tbsp/tsp/cup to ml on liquid ingredient notes (oil, milk, etc.)
# ENRICHMENT_LIQUID_VOLUME_CONV=true
